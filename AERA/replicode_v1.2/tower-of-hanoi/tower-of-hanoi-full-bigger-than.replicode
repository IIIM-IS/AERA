; ==== Eject programs ====
pgm_eject_cmd_move_block:(pgm [] []
    (ptn (fact G:(goal (fact (cmd move_block [B: P:] :) ::) ::) ::) [])
[]
    (= (is_sim G) false)
[]
    (cmd move_block [B P] 1)
1) |[]
(ipgm pgm_eject_cmd_move_block [] RUN_ALWAYS MAX_TIME VOLATILE NOTIFY 1) []
   [SYNC_ONCE now 0 forever primary nil 1]
