; ==== Eject programs ====
pgm_eject_cmd_check_oil:(pgm [] []
    (ptn (fact G:(goal (fact (cmd check_oil [C:] :) ::) ::) ::) [])
[]
    (= (is_sim G) false)
[]
    (cmd check_oil [C] 1)
1) |[]
(ipgm pgm_eject_cmd_check_oil [] RUN_ALWAYS MAX_TIME VOLATILE NOTIFY 1) []
   [SYNC_ONCE now 0 forever primary nil 1]

pgm_eject_cmd_enter_car:(pgm [] []
