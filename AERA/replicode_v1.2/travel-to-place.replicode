cst_YouHome:(cst [] []
   (fact (mk.val Y: essence yourself :) T0: T1: : :)
   (fact (mk.val Y: position home :) T0: T1: : :)
   (fact (mk.val C: essence e_car :) T0: T1: : :)
|[]
|[]
[stdin] 1) [[SYNC_ONCE now 0 forever primary nil 1]]

